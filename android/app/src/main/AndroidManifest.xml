<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Расписание загружается с apps.mitso.by. В шаблоне Flutter это разрешение
         было только в debug/profile, и release-сборка не смогла бы выйти в сеть. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Уведомление о долге по лицевому счёту: Android 13+ спрашивает
         разрешение, приложение просит его при включении настройки. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Приложение обновляет себя само: скачивает APK из своего релиза на
         GitHub, проверяет подпись манифеста и открывает системный установщик. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Напоминания о начале пары планируются заранее и живут в системе:
         RECEIVE_BOOT_COMPLETED — чтобы пережить перезагрузку. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Уведомление должно приходить в своё время, а не «примерно».
         USE_EXACT_ALARM (Android 13+) выдаётся при установке и ничего не
         спрашивает: он для приложений, которые показывают события в
         назначенное время — календарей, будильников и расписаний.
         https://developer.android.com/about/versions/14/changes/schedule-exact-alarms
         На Android 12 такого разрешения ещё нет, там работает
         SCHEDULE_EXACT_ALARM: оно выдано по умолчанию, но его можно отнять —
         тогда планировщик откатывается на неточное время (LessonReminders).
         Звонка будильника нет: приложение просто просыпается и показывает
         обычное уведомление. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32"/>
    <application
        android:label="Расписание"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
        </activity>
        <!-- Скачанный APK обновления отдаётся установщику по content://:
             file:// начиная с Android 7 приводит к FileUriExposedException. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
        <!-- Вариант значка «Печенька и шапка»: включается из настроек приложения. -->
        <activity-alias
            android:name=".MainActivityDefault"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="Расписание">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Вариант значка «Шапка»: включается из настроек приложения. -->
        <activity-alias
            android:name=".MainActivityCap"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_cap"
            android:roundIcon="@mipmap/ic_launcher_cap_round"
            android:label="Расписание">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Вариант значка «Печенька и часы»: включается из настроек приложения. -->
        <activity-alias
            android:name=".MainActivityClock"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_clock"
            android:roundIcon="@mipmap/ic_launcher_clock_round"
            android:label="Расписание">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Вариант значка «Карточка и шапка»: включается из настроек приложения. -->
        <activity-alias
            android:name=".MainActivityCard"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_card"
            android:roundIcon="@mipmap/ic_launcher_card_round"
            android:label="Расписание">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Приёмники flutter_local_notifications: первый показывает
             запланированное уведомление, второй восстанавливает расписание
             уведомлений после перезагрузки и обновления приложения.
             Плагин их не объявляет — это делает приложение (README плагина,
             раздел «AndroidManifest.xml setup»). -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
