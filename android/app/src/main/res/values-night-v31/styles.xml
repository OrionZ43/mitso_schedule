<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash screen API (Android 12+): роль сплэша выполняет система,
         а не индикатор загрузки внутри приложения —
         https://m3.material.io/components/loading-indicator/guidelines -->
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
